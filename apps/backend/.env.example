# HomiePG Backend Environment Variables

# Server Configuration
PORT=5005

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase PostgreSQL Direct Database Connection (for DB migrations/seeds)
DATABASE_PASSWORD=your_database_password

# Encryption Key (32-byte hex string for AES-256 field encryption)
# Generate a unique key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Developer Authentication Settings
# DEV_OTP: Leave blank to generate random 6-digit OTPs. Set to a static 6-digit code (e.g. 123456) for predictable local testing.
DEV_OTP=

# SHOW_DEV_OTP: Set to "true" in dev to include generated OTP in API responses for demo banner. Set to "false" in production.
SHOW_DEV_OTP=true

# Optional: Google Gemini API Key (for AI-assisted property and room description generation)
GEMINI_API_KEY=
